#!/bin/bash

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LIB_DIR="$(cd "${SCRIPT_DIR}/../lib" && pwd)"

export UVM_HOME="${UVM_HOME:-${HOME}/.config/uvm}"

# shellcheck source=lib/uvm-config.sh
source "${LIB_DIR}/uvm-config.sh" || { echo "Error: Failed to load uvm-config.sh from ${LIB_DIR}" >&2; exit 1; }
uvm_load_user_config
# shellcheck source=lib/uvm-core.sh
source "${LIB_DIR}/uvm-core.sh" || { echo "Error: Failed to load uvm-core.sh from ${LIB_DIR}" >&2; exit 1; }
# shellcheck source=lib/uvm-shell-hooks.sh
source "${LIB_DIR}/uvm-shell-hooks.sh" || { echo "Error: Failed to load uvm-shell-hooks.sh from ${LIB_DIR}" >&2; exit 1; }

UVM_VERSION="1.2.2"

show_version() {
    echo "uvm version ${UVM_VERSION}"
    echo "UV Manager - A Conda-like environment manager for UV"
}

main() {
    local command="$1"
    shift || true

    case "$command" in
        create)
            uvm_create "$@"
            ;;
        activate)
            echo "Note: 'uvm activate' must run inside shell integration."
            echo "Add this to your shell RC file:"
            echo "    eval \"\$(uvm shell-hook)\""
            echo ""
            echo "Then run: uvm activate <env_name>"
            return 1
            ;;
        deactivate)
            echo "Note: 'uvm deactivate' must run inside shell integration."
            echo "Add this to your shell RC file:"
            echo "    eval \"\$(uvm shell-hook)\""
            return 1
            ;;
        delete|remove|rm)
            uvm_delete "$@"
            ;;
        run)
            uvm_run "$@"
            ;;
        rename)
            uvm_rename "$@"
            ;;
        clone)
            uvm_clone "$@"
            ;;
        export)
            uvm_export "$@"
            ;;
        import)
            uvm_import "$@"
            ;;
        update)
            uvm_self_update "$@"
            ;;
        trust)
            if [ "${1:-}" = "list" ] || [ "${1:-}" = "--list" ]; then
                if [ $# -ne 1 ]; then
                    echo "Usage: uvm trust [path] | uvm trust list"
                    return 1
                fi
                uvm_list_trusted_local_envs
                return 0
            fi
            local trust_path="${1:-${PWD}/.venv}"
            if [ $# -gt 1 ]; then
                echo "Usage: uvm trust [path] | uvm trust list"
                return 1
            fi
            trust_path=$(uvm_trust_local_env "$trust_path") || return 1
            echo "Trusted local environment: ${trust_path}"
            ;;
        untrust)
            local untrust_path="${1:-${PWD}/.venv}"
            if [ $# -gt 1 ]; then
                echo "Usage: uvm untrust [path]"
                return 1
            fi
            uvm_untrust_local_env "$untrust_path" || return 1
            echo "Local environment is no longer trusted: ${untrust_path}"
            ;;
        list|ls)
            uvm_list "$@"
            ;;
        shell-hook)
            uvm_generate_shell_hook
            ;;
        init)
            echo "Initializing uvm..."
            init_uvm_config
            setup_uv_mirror
            scan_and_register_envs "$(uvm_get_default_envs_dir)" >/dev/null
            echo "uvm initialized successfully"
            ;;
        scan|register)
            local scan_dir="${1:-$(uvm_get_default_envs_dir)}"
            if [ ! -d "$scan_dir" ]; then
                echo "Error: Directory not found: $scan_dir"
                return 1
            fi
            local registered_count
            registered_count=$(scan_and_register_envs "$scan_dir")
            echo "Registered ${registered_count} environment(s)"
            ;;
        doctor)
            uvm_doctor
            ;;
        repair)
            uvm_repair
            ;;
        config)
            uvm_config_command "$@"
            ;;
        help|--help|-h)
            uvm_help
            ;;
        version|--version|-v)
            show_version
            ;;
        "")
            uvm_help
            ;;
        *)
            echo "Error: Unknown command: $command"
            echo "Run 'uvm help' for usage information"
            return 1
            ;;
    esac
}

# Keep exit on the same line: bash must never read past here after `uvm update`
# replaces this file.
main "$@"; exit $?
