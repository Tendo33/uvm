#!/bin/bash

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LIB_DIR="$(cd "${SCRIPT_DIR}/../lib" && pwd)"

export UVM_HOME="${UVM_HOME:-${HOME}/.config/uvm}"

source "${LIB_DIR}/uvm-config.sh"
uvm_load_user_config
source "${LIB_DIR}/uvm-core.sh"
source "${LIB_DIR}/uvm-shell-hooks.sh"

UVM_VERSION="1.1.0"

show_version() {
    echo "uvm version ${UVM_VERSION}"
    echo "UV Manager - A Conda-like environment manager for UV"
}

main() {
    local command="$1"
    shift || true

    case "$command" in
        create)
            uvm_create "$@"
            ;;
        activate)
            echo "Note: 'uvm activate' must run inside shell integration."
            echo "Add this to your shell RC file:"
            echo "    eval \"\$(uvm shell-hook)\""
            echo ""
            echo "Then run: uvm activate <env_name>"
            return 1
            ;;
        deactivate)
            echo "Note: 'uvm deactivate' must run inside shell integration."
            echo "Add this to your shell RC file:"
            echo "    eval \"\$(uvm shell-hook)\""
            return 1
            ;;
        delete|remove|rm)
            uvm_delete "$@"
            ;;
        list|ls)
            uvm_list "$@"
            ;;
        shell-hook)
            uvm_generate_shell_hook
            ;;
        init)
            echo "Initializing uvm..."
            init_uvm_config
            setup_uv_mirror
            scan_and_register_envs "$(uvm_get_default_envs_dir)" >/dev/null
            echo "uvm initialized successfully"
            ;;
        scan|register)
            local scan_dir="${1:-$(uvm_get_default_envs_dir)}"
            if [ ! -d "$scan_dir" ]; then
                echo "Error: Directory not found: $scan_dir"
                return 1
            fi
            local registered_count
            registered_count=$(scan_and_register_envs "$scan_dir")
            echo "Registered ${registered_count} environment(s)"
            ;;
        doctor)
            uvm_doctor
            ;;
        repair)
            uvm_repair
            ;;
        config)
            local subcommand="$1"
            shift || true
            case "$subcommand" in
                mirror|mirrors)
                    setup_uv_mirror
                    echo "Mirror configuration updated"
                    ;;
                show)
                    echo "UVM Configuration:"
                    echo "  UVM_HOME: $(uvm_get_home)"
                    echo "  UVM_ENVS_DIR: $(uvm_get_default_envs_dir)"
                    echo "  Metadata directory: $(uvm_get_env_records_dir)"
                    echo "  Shell: $(detect_shell)"
                    echo "  Shell RC: $(get_shell_rc_file)"
                    ;;
                *)
                    echo "Usage: uvm config <mirror|show>"
                    return 1
                    ;;
            esac
            ;;
        help|--help|-h)
            uvm_help
            ;;
        version|--version|-v)
            show_version
            ;;
        "")
            uvm_help
            ;;
        *)
            echo "Error: Unknown command: $command"
            echo "Run 'uvm help' for usage information"
            return 1
            ;;
    esac
}

main "$@"
