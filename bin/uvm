#!/bin/bash

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LIB_DIR="$(cd "${SCRIPT_DIR}/../lib" && pwd)"

export UVM_HOME="${UVM_HOME:-${HOME}/.config/uvm}"

source "${LIB_DIR}/uvm-config.sh"
uvm_load_user_config
source "${LIB_DIR}/uvm-core.sh"
source "${LIB_DIR}/uvm-shell-hooks.sh"

UVM_VERSION="1.1.1"

show_version() {
    echo "uvm version ${UVM_VERSION}"
    echo "UV Manager - A Conda-like environment manager for UV"
}

main() {
    local command="$1"
    shift || true

    case "$command" in
        create)
            uvm_create "$@"
            ;;
        activate)
            echo "Note: 'uvm activate' must run inside shell integration."
            echo "Add this to your shell RC file:"
            echo "    eval \"\$(uvm shell-hook)\""
            echo ""
            echo "Then run: uvm activate <env_name>"
            return 1
            ;;
        deactivate)
            echo "Note: 'uvm deactivate' must run inside shell integration."
            echo "Add this to your shell RC file:"
            echo "    eval \"\$(uvm shell-hook)\""
            return 1
            ;;
        delete|remove|rm)
            uvm_delete "$@"
            ;;
        run)
            uvm_run "$@"
            ;;
        rename)
            uvm_rename "$@"
            ;;
        clone)
            uvm_clone "$@"
            ;;
        export)
            uvm_export "$@"
            ;;
        import)
            uvm_import "$@"
            ;;
        update)
            uvm_self_update "$@"
            ;;
        list|ls)
            uvm_list "$@"
            ;;
        shell-hook)
            uvm_generate_shell_hook
            ;;
        init)
            echo "Initializing uvm..."
            init_uvm_config
            setup_uv_mirror
            scan_and_register_envs "$(uvm_get_default_envs_dir)" >/dev/null
            echo "uvm initialized successfully"
            ;;
        scan|register)
            local scan_dir="${1:-$(uvm_get_default_envs_dir)}"
            if [ ! -d "$scan_dir" ]; then
                echo "Error: Directory not found: $scan_dir"
                return 1
            fi
            local registered_count
            registered_count=$(scan_and_register_envs "$scan_dir")
            echo "Registered ${registered_count} environment(s)"
            ;;
        doctor)
            uvm_doctor
            ;;
        repair)
            uvm_repair
            ;;
        config)
            local subcommand="$1"
            shift || true
            case "$subcommand" in
                mirror|mirrors)
                    local mirror_action="${1:-show}"
                    shift || true
                    case "$mirror_action" in
                        set)
                            local mirror_url="${1:-}"
                            if [ -z "$mirror_url" ]; then
                                echo "Usage: uvm config mirror set <url>"
                                echo "Example: uvm config mirror set https://pypi.tuna.tsinghua.edu.cn/simple"
                                return 1
                            fi
                            setup_uv_mirror "$mirror_url" || return 1
                            echo "Mirror set to: ${mirror_url}"
                            ;;
                        remove)
                            uvm_remove_managed_block \
                                "$(uvm_get_uv_config_file)" \
                                "$(uvm_get_mirror_start_marker)" \
                                "$(uvm_get_mirror_end_marker)"
                            echo "Mirror configuration removed from $(uvm_get_uv_config_file)"
                            ;;
                        show)
                            if uvm_file_contains_managed_block \
                                "$(uvm_get_uv_config_file)" \
                                "$(uvm_get_mirror_start_marker)" \
                                "$(uvm_get_mirror_end_marker)"; then
                                echo "Managed mirror block is configured in: $(uvm_get_uv_config_file)"
                            else
                                echo "No managed mirror block found"
                                echo "  To add: uvm config mirror set <url>"
                                echo "  Example: uvm config mirror set https://pypi.tuna.tsinghua.edu.cn/simple"
                            fi
                            ;;
                        *)
                            echo "Usage: uvm config mirror <set <url> | remove | show>"
                            return 1
                            ;;
                    esac
                    ;;
                show)
                    echo "UVM Configuration:"
                    echo "  UVM_HOME: $(uvm_get_home)"
                    echo "  UVM_ENVS_DIR: $(uvm_get_default_envs_dir)"
                    echo "  Metadata directory: $(uvm_get_env_records_dir)"
                    echo "  Shell: $(detect_shell)"
                    echo "  Shell RC: $(get_shell_rc_file)"
                    ;;
                *)
                    echo "Usage: uvm config <mirror|show>"
                    return 1
                    ;;
            esac
            ;;
        help|--help|-h)
            uvm_help
            ;;
        version|--version|-v)
            show_version
            ;;
        "")
            uvm_help
            ;;
        *)
            echo "Error: Unknown command: $command"
            echo "Run 'uvm help' for usage information"
            return 1
            ;;
    esac
}

main "$@"
